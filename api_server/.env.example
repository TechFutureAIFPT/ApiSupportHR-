APP_NAME=SupportHR Backend
FRONTEND_ORIGIN=https://www.supporthr-tf.com.vn

MAINTENANCE_MODE=false

# Supabase production (set only in the secret manager; use the pooled Supavisor URL).
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
DATABASE_URL=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=15
POSTGRES_POOL_MAX_WAITING=60
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_POOL_MAX_IDLE_SECONDS=300
POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
POSTGRES_POOL_RECONNECT_TIMEOUT_SECONDS=60
POSTGRES_POOL_WORKERS=3
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Base64-encoded 32-byte AES-GCM key for Google Drive tokens.
DATA_ENCRYPTION_KEY=

# Gemini / Google AI
# Gemini 3.6 Flash is GA. Sampling parameters are omitted for this model by the backend adapter.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CV_ANALYSIS_MODEL=gemini-3.6-flash
QUICK_CV_GEMINI_MODEL=gemini-3.6-flash
QUICK_CV_GEMINI_API_KEY=
MOBILE_JD_GEMINI_MODEL=gemini-3.6-flash
MOBILE_JD_GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GOOGLE_API_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

REDIS_URL=
REDIS_INTERNAL_URL=
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=2
ANALYSIS_JOB_MODE=in_process
ANALYSIS_JOB_QUEUE_KEY=supporthr:analysis:stream
ANALYSIS_JOB_CONSUMER_GROUP=supporthr-workers
ANALYSIS_JOB_RECLAIM_IDLE_SECONDS=3600
ANALYSIS_JOB_STREAM_MAX_LENGTH=10000
ANALYSIS_JOB_RESULT_TTL_SECONDS=86400
ANALYSIS_JOB_LEASE_SECONDS=3600
ANALYSIS_JOB_MAX_CONCURRENCY_PER_USER=3
ACCOUNT_CACHE_TTL_SECONDS=120
SETTINGS_CACHE_TTL_SECONDS=600
MOBILE_INBOX_CACHE_TTL_SECONDS=60
TEMPLATE_CACHE_TTL_SECONDS=300
SYNC_CACHE_TTL_SECONDS=300
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESS_LEVEL=5
UPLOAD_FILE_SIZE_LIMIT_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt,.png,.jpg,.jpeg
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg

# Google Drive OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_ALLOWED_ORIGINS=http://localhost:3000,https://www.supporthr-tf.com.vn

# Supabase vector store
VECTOR_STORE_COLLECTION=vectorLibraryRecords
APPROVED_EXEMPLARS_COLLECTION=approvedExemplars
RUBRIC_VERSION=v2
VECTOR_INDEX_VERSION=gemini-embedding-2-768-v1
LOCAL_CLASSIFIER_MODE=local
LOCAL_CLASSIFIER_REMOTE_CLASSIFY_URL=
LOCAL_CLASSIFIER_REMOTE_STATUS_URL=
LOCAL_CLASSIFIER_REMOTE_TIMEOUT_SECONDS=10
LOCAL_CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
RAG_SIMILARITY_THRESHOLD=0.75
RAG_MAX_EXEMPLARS=2
RAG_CANDIDATE_LIMIT=100
# GraphRAG is evidence-only in phase 1. Shadow mode never changes prompts, scores, or ranks.
GRAPH_RAG_ENABLED=false
GRAPH_RAG_SHADOW_MODE=true
GRAPH_RAG_ARTIFACT_PATH=
GRAPH_RAG_MAX_FACTS=8
AI_PREPROCESS_CONCURRENCY=4
REQUIRE_CLASSIFIER_READY=true
