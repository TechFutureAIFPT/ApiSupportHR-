APP_NAME=SupportHR Backend
FRONTEND_ORIGIN=https://www.supporthr-tf.com.vn

# Gemini / Google AI
# Recommended default: stronger reasoning than the old flash alias while still cost-efficient.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GOOGLE_API_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Firebase Web config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_APPCHECK_SITE_KEY=

# Google Drive OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_ALLOWED_ORIGINS=http://localhost:3000,https://www.supporthr-tf.com.vn

# Vector store
VECTOR_STORE_PROVIDER=auto
VECTOR_STORE_JSON_DIR=
VECTOR_STORE_FIRESTORE_COLLECTION=vectorLibraryRecords
