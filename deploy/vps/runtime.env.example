# Compose and HTTPS
SUPPORTHR_IMAGE_REF=ghcr.io/techfutureaifpt/supporthr-backend:main
SUPPORTHR_ENV_FILE=./deploy/vps/runtime.env
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Application
APP_NAME=SupportHR Backend
FRONTEND_ORIGIN=https://www.supporthr-tf.com.vn
MAINTENANCE_MODE=false

# Supabase Auth/PostgreSQL. Use the pooled Supavisor DATABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_MAX_WAITING=40
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_POOL_WORKERS=2

# Gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CV_ANALYSIS_MODEL=gemini-3.6-flash
QUICK_CV_GEMINI_MODEL=gemini-3.6-flash
MOBILE_JD_GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=
QUICK_CV_GEMINI_API_KEY=replace-me
MOBILE_JD_GEMINI_API_KEY=replace-me
GOOGLE_API_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# Internal Redis URLs are injected by compose.production.yaml.
REDIS_MAX_CONNECTIONS=30
ANALYSIS_JOB_MODE=redis
ANALYSIS_JOB_MAX_CONCURRENCY_PER_USER=2

# Google Drive OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/google-drive/oauth/callback
GOOGLE_DRIVE_ALLOWED_ORIGINS=https://www.supporthr-tf.com.vn

# RAG/runtime
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
VECTOR_INDEX_VERSION=gemini-embedding-2-768-v1
LOCAL_CLASSIFIER_MODE=local
REQUIRE_CLASSIFIER_READY=true
